{
  "name": "BI Factory SEPPE",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [
    8502,
    8503,
    8505,
    8506
  ],
  "portsAttributes": {
    "8502": {
      "label": "BI Factory Streamlit",
      "onAutoForward": "notify"
    },
    "8503": {
      "label": "Sala de Situação SEPPE",
      "onAutoForward": "notify"
    },
    "8505": {
      "label": "BI Factory API",
      "onAutoForward": "openBrowserOnce"
    },
    "8506": {
      "label": "BI Factory Aplicação",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "postStartCommand": "bash scripts/autostart_bi_factory_codespaces.sh"
}
